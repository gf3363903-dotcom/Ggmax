local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Player = Players.LocalPlayer

--==================================================
-- CONFIG
--==================================================

local Settings = {
	AutoFarm = false,
	TowerFarm = false,
	EventFarm = false,
	AutoCollect = false,

	AttackDelay = 0.25,
	AttackDistance = 7,
}

--==================================================
-- REMOTES
--==================================================

local Remotes = ReplicatedStorage:WaitForChild("Remotes")

local AttackRemote = Remotes:WaitForChild("Attack")
local CollectRemote = Remotes:FindFirstChild("Collect")

--==================================================
-- CHARACTER
--==================================================

local function Character()
	return Player.Character or Player.CharacterAdded:Wait()
end

local function Root()
	return Character():FindFirstChild("HumanoidRootPart")
end

--==================================================
-- ENEMY
--==================================================

local function FindNearest(folder)
	local root = Root()
	if not root or not folder then
		return nil
	end

	local nearest = nil
	local distance = math.huge

	for _, enemy in ipairs(folder:GetChildren()) do
		local humanoid = enemy:FindFirstChildOfClass("Humanoid")
		local enemyRoot = enemy:FindFirstChild("HumanoidRootPart")

		if humanoid and enemyRoot and humanoid.Health > 0 then
			local d = (root.Position - enemyRoot.Position).Magnitude

			if d < distance then
				distance = d
				nearest = enemy
			end
		end
	end

	return nearest
end

--==================================================
-- ATTACK
--==================================================

local function Attack(enemy)
	if not enemy then
		return
	end

	local enemyRoot = enemy:FindFirstChild("HumanoidRootPart")
	if not enemyRoot then
		return
	end

	local root = Root()
	if not root then
		return
	end

	if (root.Position - enemyRoot.Position).Magnitude > Settings.AttackDistance then
		root.CFrame = enemyRoot.CFrame * CFrame.new(0, 0, Settings.AttackDistance)
	end

	-- O servidor deve validar o alvo e o dano.
	AttackRemote:FireServer(enemy)
end

--==================================================
-- NORMAL FARM
--==================================================

task.spawn(function()
	while task.wait(Settings.AttackDelay) do
		if Settings.AutoFarm then
			local enemies = workspace:FindFirstChild("Enemies")
			local enemy = FindNearest(enemies)

			if enemy then
				Attack(enemy)
			end
		end
	end
end)

--==================================================
-- TOWER FARM
--==================================================

task.spawn(function()
	while task.wait(Settings.AttackDelay) do
		if Settings.TowerFarm then
			local tower = workspace:FindFirstChild("Tower")

			if tower then
				local enemies = tower:FindFirstChild("Enemies")

				if enemies then
					local enemy = FindNearest(enemies)

					if enemy then
						Attack(enemy)
					end
				end
			end
		end
	end
end)

--==================================================
-- EVENT FARM
--==================================================

task.spawn(function()
	while task.wait(Settings.AttackDelay) do
		if Settings.EventFarm then
			local events = workspace:FindFirstChild("Events")

			if events then
				local activeEvent = events:FindFirstChild("Active")

				if activeEvent then
					local enemies = activeEvent:FindFirstChild("Enemies")

					if enemies then
						local enemy = FindNearest(enemies)

						if enemy then
							Attack(enemy)
						end
					end
				end
			end
		end
	end
end)

--==================================================
-- AUTO COLLECT
--==================================================

task.spawn(function()
	while task.wait(0.5) do
		if Settings.AutoCollect and CollectRemote then
			CollectRemote:FireServer()
		end
	end
end)

