-- ===== ESP DRAWING =====
local espObjects = {}

local function criarEsp(part, cor, tamanho)
    local box = Instance.new("BoxHandleAdornment")
    box.AlwaysOnTop = true
    box.Adornee = part
    box.Size = part.Size + Vector3.new(0.5, 0.5, 0.5) * tamanho
    box.Color3 = cor
    box.Transparency = 0.3
    box.ZIndex = 10
    box.Parent = part
    
    local outline = Instance.new("BoxHandleAdornment")
    outline.AlwaysOnTop = true
    outline.Adornee = part
    outline.Size = part.Size + Vector3.new(0.7, 0.7, 0.7) * tamanho
    outline.Color3 = Color3.fromRGB(255, 255, 255)
    outline.Transparency = 0.1
    outline.ZIndex = 9
    outline.Parent = part
    
    return {box, outline}
end

local function removerEsp(part)
    if espObjects[part] then
        for _, obj in pairs(espObjects[part]) do
            obj:Destroy()
        end
        espObjects[part] = nil
    end
end

-- ===== ATUALIZAR ESP =====
RunService.RenderStepped:Connect(function()
    if not espAtivo then
        for part, objs in pairs(espObjects) do
            for _, obj in pairs(objs) do
                obj:Destroy()
            end
        end
        espObjects = {}
        return
    end
    
    local novosObjetos = {}
    
    for _, jogador in pairs(Players:GetPlayers()) do
        if jogador ~= player and jogador.Character and jogador.Character:FindFirstChild("HumanoidRootPart") then
            local root = jogador.Character.HumanoidRootPart
            local dist = (root.Position - camera.CFrame.Position).Magnitude
            
            if dist <= distanciaMax then
                if not espObjects[root] then
                    espObjects[root] = criarEsp(root, corEsp, tamanhoEsp)
                else
                    -- Atualizar cor e tamanho
                    for _, obj in pairs(espObjects[root]) do
                        if obj:IsA("BoxHandleAdornment") then
                            if obj.Color3 ~= Color3.fromRGB(255, 255, 255) then
                                obj.Color3 = corEsp
                            end
                            obj.Size = root.Size + Vector3.new(0.5, 0.5, 0.5) * tamanhoEsp
                        end
                    end
                end
                novosObjetos[root] = true
            else
                removerEsp(root)
            end
        end
    end
    
    -- Remover ESP de jogadores que saíram
    for part, _ in pairs(espObjects) do
        if not novosObjetos[part] then
            removerEsp(part)
        end
    end
end)

