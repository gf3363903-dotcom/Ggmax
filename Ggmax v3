	if Input.UserInputType ==
		Enum.UserInputType.MouseButton1
		or Input.UserInputType ==
		Enum.UserInputType.Touch then

		Arrastando = false

	end

end)

--==================================================
-- AIMBOT
--==================================================

local function JogadorValido(Player)

	if Player == LocalPlayer then
		return false
	end

	if Config.TeamCheck
		and LocalPlayer.Team ~= nil
		and Player.Team ==
		LocalPlayer.Team then

		return false
	end

	local Character =
		Player.Character

	if not Character then
		return false
	end

	local Humanoid =
		Character:FindFirstChildOfClass(
			"Humanoid"
		)

	if not Humanoid
		or Humanoid.Health <= 0 then

		return false
	end

	return true

end

local function ParteAlvo(Character)

	if Config.AimPart == "Head" then

		return Character:FindFirstChild("Head")

	end

	return Character:FindFirstChild(
		"HumanoidRootPart"
	)
	or Character:FindFirstChild(
		"UpperTorso"
	)
	or Character:FindFirstChild(
		"Torso"
	)

end

local function Visivel(Part)

	if not Config.VisibleCheck then
		return true
	end

	local Character =
		LocalPlayer.Character

	if not Character then
		return false
	end

	local Params =
		RaycastParams.new()

	Params.FilterType =
		Enum.RaycastFilterType.Exclude

	Params.FilterDescendantsInstances =
		{Character}

	local Direcao =
		Part.Position
		- Camera.CFrame.Position

	local Resultado =
		workspace:Raycast(
			Camera.CFrame.Position,
			Direcao,
			Params
		)

	if not Resultado then
		return true
	end

	return Resultado.Instance:IsDescendantOf(
		Part.Parent
	)

end

local function MelhorAlvo()

	local Melhor = nil
	local MelhorDistancia = math.huge

	local Centro =
		Camera.ViewportSize / 2

	for _, Player in
		ipairs(Players:GetPlayers()) do

		if JogadorValido(Player) then

			local Character =
				Player.Character

			local Part =
				ParteAlvo(Character)

			if Part then

				local Distancia =
					(
						Part.Position
						- Camera.CFrame.Position
					).Magnitude

				if Distancia <=
					Config.MaxDistance then

					local Posicao,
						NaTela =
						Camera:WorldToViewportPoint(
							Part.Position
						)

					if NaTela then

						local DistanciaTela =
							(
								Vector2.new(
									Posicao.X,
									Posicao.Y
								)
								- Centro
							).Magnitude

						if DistanciaTela <=
							Config.FOV
							and DistanciaTela <
							MelhorDistancia
							and Visivel(Part) then

							Melhor =
								Part

							MelhorDistancia =
								DistanciaTela

						end

					end

				end

			end

		end

	end

	return Melhor

end

--==================================================
-- ESP
--==================================================

local ESPFolder =
	Instance.new("Folder")

ESPFolder.Name =
	"CaixasESP"

ESPFolder.Parent =
	Gui

local ESPObjects = {}

local function CriarESP(Player)

	if Player == LocalPlayer then
		return
	end

	local Character =
		Player.Character

	if not Character then
		return
	end

	if ESPObjects[Player] then

		ESPObjects[Player]:Destroy()

	end

	local Highlight =
		Instance.new("Highlight")

	Highlight.Name =
		"Caixa"

	Highlight.Adornee =
		Character

	Highlight.FillColor =
		Colors.ESP

	Highlight.OutlineColor =
		Colors.ESP

	Highlight.FillTransparency =
		0.9

	Highlight.OutlineTransparency =
		0

	Highlight.DepthMode =
		Enum.HighlightDepthMode.AlwaysOnTop

	Highlight.Enabled =
		Config.ESP

	Highlight.Parent =
		ESPFolder

	ESPObjects[Player] =
		Highlight

end

local function AtualizarESP()

	for _, Player in
		ipairs(Players:GetPlayers()) do

		if Player ~= LocalPlayer then

			local Highlight =
				ESPObjects[Player]

			if not Highlight then

				CriarESP(Player)

				Highlight =
					ESPObjects[Player]

			end

			if Highlight then

				local Mostrar =
					Config.ESP
					and JogadorValido(Player)

				local Character =
					Player.Character

				if Character then

					local Root =
						Character:FindFirstChild(
							"HumanoidRootPart"
						)

					if Root then

						local Distancia =
							(
								Root.Position
								- Camera.CFrame.Position
							).Magnitude

						if Distancia >
							Config.ESPMaxDistance then

							Mostrar = false

						end

					else

						Mostrar = false

					end

				else

					Mostrar = false

				end

				Highlight.Enabled =
					Mostrar

			end

		end

	end

end

Players.PlayerAdded:Connect(function(Player)

	Player.CharacterAdded:Connect(function()

		task.wait(0.5)

		CriarESP(Player)

	end)

end)

Players.PlayerRemoving:Connect(function(Player)

	if ESPObjects[Player] then

		ESPObjects[Player]:Destroy()

		ESPObjects[Player] = nil

	end

end)

for _, Player in
	ipairs(Players:GetPlayers()) do

	if Player ~= LocalPlayer then

		if Player.Character then
			CriarESP(Player)
		end

		Player.CharacterAdded:Connect(function()

			task.wait(0.5)

			CriarESP(Player)

		end)

	end

end

--==================================================
-- LOOP
--==================================================

RunService:BindToRenderStep(
	"ControleAimbot",
	Enum.RenderPriority.Camera.Value + 1,
	function()

		Camera =
			workspace.CurrentCamera

		AtualizarESP()

		if not Config.Aimbot then
			return
		end

		local Target =
			MelhorAlvo()

		if not Target then
			return
		end

		local CameraPosition =
			Camera.CFrame.Position

		local TargetCFrame =
			CFrame.lookAt(
				CameraPosition,
				Target.Position
			)

		Camera.CFrame =
			Camera.CFrame:Lerp(
				TargetCFrame,
				math.clamp(
					Config.Smoothness,
					0.01,
					1
				)
