	{ nivel = 1, nome = "Inseto Rosa",	modelo = "InsetoRosa" },
	{ nivel = 2, nome = "Formiga",		modelo = "Formiga", requisitoXP = 10 },
	{ nivel = 3, nome = "Besouro",		modelo = "Besouro", requisitoXP = 30 },
	{ nivel = 4, nome = "Escorpião",	modelo = "Escorpiao", requisitoXP = 60 }
}

-- Função chamada sempre que o jogador come algo no jogo
function aoComerAlimento(valorXP)
	pontosDeExperiencia = pontosDeExperiencia + valorXP
	
	-- Verifica se pode evoluir
	local proximaEvolucao = evolucoes[nivelAtual + 1]
	if proximaEvolucao and pontosDeExperiencia >= proximaEvolucao.requisitoXP then
		nivelAtual = nivelAtual + 1
		evoluirJogador(proximaEvolucao.modelo)
		print("Evoluiu para: " .. proximaEvolucao.nome)
	end
end

