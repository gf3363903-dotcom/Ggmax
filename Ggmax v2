--==================================================
-- LOOP PRINCIPAL
--==================================================

RunService:BindToRenderStep(
	"AimAssist",
	Enum.RenderPriority.Camera.Value + 1,

	function()

		Camera =
			workspace.CurrentCamera

		UpdateFOV()

		UpdateESP()

		if not Config.Enabled then
			return
		end

		local Target =
			GetBestTarget()

		if not Target then
			return
		end

		local CameraPosition =
			Camera.CFrame.Position

		local TargetCFrame =
			CFrame.lookAt(
				CameraPosition,
				Target.Position
			)

		local Alpha =
			math.clamp(
				Config.Smoothness,
				0.01,
				1
			)

		Camera.CFrame =
			Camera.CFrame:Lerp(
				TargetCFrame,
				Alpha
			)

	end
)

