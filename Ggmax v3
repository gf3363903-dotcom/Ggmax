local function CriarSlider(
	Page,
	Nome,
	Min,
	Max,
	Inicial,
	Ordem,
	Callback
)

	local Holder = Instance.new("Frame")

	Holder.Size =
		UDim2.new(1, 0, 0, 58)

	Holder.BackgroundColor3 =
		Colors.Painel

	Holder.BorderSizePixel = 0

	Holder.LayoutOrder =
		Ordem

	Holder.Parent =
		Page

	local Corner = Instance.new("UICorner")
	Corner.CornerRadius =
		UDim.new(0, 8)

	Corner.Parent =
		Holder

	local Label = Instance.new("TextLabel")

	Label.Size =
		UDim2.new(1, -20, 0, 22)

	Label.Position =
		UDim2.fromOffset(10, 3)

	Label.BackgroundTransparency = 1

	Label.TextColor3 =
		Colors.Cinza

	Label.Font =
		Enum.Font.Gotham

	Label.TextSize = 11
	Label.TextXAlignment =
		Enum.TextXAlignment.Left

	Label.Parent =
		Holder

	local Track = Instance.new("Frame")

	Track.Size =
		UDim2.new(1, -20, 0, 6)

	Track.Position =
		UDim2.new(0, 10, 0, 38)

	Track.BackgroundColor3 =
		Colors.Fundo

	Track.BorderSizePixel = 0

	Track.Parent =
		Holder

	local Fill = Instance.new("Frame")

	Fill.BackgroundColor3 =
		Colors.Azul

	Fill.BorderSizePixel = 0

	Fill.Size =
		UDim2.new(0, 0, 1, 0)

	Fill.Parent =
		Track

	local dragging = false

	local function SetValue(X)

		local Percent =
			math.clamp(
				(X - Track.AbsolutePosition.X)
				/ Track.AbsoluteSize.X,
				0,
				1
			)

		local Value =
			Min + (Max - Min) * Percent

		if Max - Min >= 10 then

			Value =
				math.floor(Value + 0.5)

		else

			Value =
				math.floor(Value * 100 + 0.5)
				/ 100

		end

		local FinalPercent =
			(Value - Min)
			/ (Max - Min)

		Fill.Size =
			UDim2.new(
				FinalPercent,
				0,
				1,
				0
			)

		Label.Text =
			Nome .. ": " .. tostring(Value)

		if Callback then
			Callback(Value)
		end

	end

	task.defer(function()

		local Percent =
			(Inicial - Min)
			/ (Max - Min)

		SetValue(
			Track.AbsolutePosition.X
			+ Track.AbsoluteSize.X
			* Percent
		)

	end)

	Track.InputBegan:Connect(function(Input)

		if Input.UserInputType ==
			Enum.UserInputType.MouseButton1
			or Input.UserInputType ==
			Enum.UserInputType.Touch then

			dragging = true

			SetValue(
				Input.Position.X
			)

		end

	end)

	UserInputService.InputChanged:Connect(function(Input)

		if not dragging then
			return
		end

		if Input.UserInputType ==
			Enum.UserInputType.MouseMovement
			or Input.UserInputType ==
			Enum.UserInputType.Touch then

			SetValue(
				Input.Position.X
			)

		end

	end)

	UserInputService.InputEnded:Connect(function(Input)

		if Input.UserInputType ==
			Enum.UserInputType.MouseButton1
			or Input.UserInputType ==
			Enum.UserInputType.Touch then

			dragging = false

		end

	end)

end

