local function Button(text, callback)
	local button = Instance.new("TextButton")
	button.Size = UDim2.fromOffset(230, 40)
	button.BackgroundColor3 = Color3.fromRGB(45, 45, 55)
	button.TextColor3 = Color3.new(1, 1, 1)
	button.TextSize = 15
	button.Font = Enum.Font.GothamSemibold
	button.Text = text
	button.LayoutOrder = #Main:GetChildren()
	button.Parent = Main

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 8)
	corner.Parent = button

	button.MouseButton1Click:Connect(function()
		callback(button)
	end)

	return button
end

local function Toggle(button, name, variable)
	Settings[variable] = not Settings[variable]

	button.Text = name .. ": " ..
		(Settings[variable] and "ON" or "OFF")
end

Button("⚔️ Auto Farm: OFF", function(button)
	Toggle(button, "⚔️ Auto Farm", "AutoFarm")
end)

Button("🗼 Tower Farm: OFF", function(button)
	Toggle(button, "🗼 Tower Farm", "TowerFarm")
end)

Button("🎉 Event Farm: OFF", function(button)
	Toggle(button, "🎉 Event Farm", "EventFarm")
end)

Button("💰 Auto Collect: OFF", function(button)
	Toggle(button, "💰 Auto Collect", "AutoCollect")
end)

Button("❌ Desligar Tudo", function()
	Settings.AutoFarm = false
	Settings.TowerFarm = false
	Settings.EventFarm = false
	Settings.AutoCollect = false

	for _, object in ipairs(Main:GetChildren()) do
		if object:IsA("TextButton") then
			if object.Text:find("Auto Farm") then
				object.Text = "⚔️ Auto Farm: OFF"
			elseif object.Text:find("Tower Farm") then
				object.Text = "🗼 Tower Farm: OFF"
			elseif object.Text:find("Event Farm") then
				object.Text = "🎉 Event Farm: OFF"
			elseif object.Text:find("Auto Collect") then
				object.Text = "💰 Auto Collect: OFF"
			end
		end
	end
end)
