    if coletandoItens then
        btnColeta.Text = "⏹ PARAR COLETA"
        btnColeta.BackgroundColor3 = Color3.fromRGB(200, 0, 0)
        spawn(function()
            while coletandoItens do
                task.wait(0.3)
                for _, objeto in pairs(workspace:GetChildren()) do
                    if objeto:IsA("Tool") then
                        local posItem = objeto:GetPivot()
                        if posItem then
                            raiz.CFrame = posItem * CFrame.new(0, 0, 2)
                            task.wait(0.1)
                            rato.Button1Click()
                            task.wait(0.15)
                        end
                    end
                end
            end
        end)
    else
        btnColeta.Text = "📦 COLETAR TUDO"
        btnColeta.BackgroundColor3 = Color3.fromRGB(200, 150, 0)
    end
end

