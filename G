-- ========== FUNÇÃO PARA CRIAR BOTÕES (OTIMIZADO PARA TOQUE) ==========
local function criarBotao(texto, posY, cor, funcao)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0.88, 0, 0, 42)
    btn.Position = UDim2.new(0.06, 0, 0, posY)
    btn.Text = texto
    btn.BackgroundColor3 = cor
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.TextScaled = true
    btn.Font = Enum.Font.SourceSansBold
    btn.AutoButtonColor = true
    
    local btnBorda = Instance.new("UICorner")
    btnBorda.CornerRadius = UDim.new(0, 10)
    btnBorda.Parent = btn
    
    -- Feedback visual para toque (Android)
    btn.MouseButton1Down:Connect(function()
        btn.BackgroundTransparency = 0.4
        task.wait(0.1)
        btn.BackgroundTransparency = 0
    end)
    
    btn.Parent = janela
    btn.MouseButton1Click:Connect(funcao)
    return btn
end

-- ========== FUNÇÃO ANTI-AFK ==========
local function iniciarAntiAFK()
    antiAFKAtivo = not antiAFKAtivo
    if antiAFKAtivo then
        btnAntiAFK.Text = "⏹ ANTI-AFK"
        btnAntiAFK.BackgroundColor3 = Color3.fromRGB(200, 50, 0)
        spawn(function()
            while antiAFKAtivo do
                task.wait(60)
                -- Movimento suave para não desconectar
                local pos = raiz.Position
                raiz.CFrame = CFrame.new(pos.X + 0.1, pos.Y, pos.Z + 0.1)
                task.wait(0.1)
                raiz.CFrame = CFrame.new(pos.X, pos.Y, pos.Z)
                -- Envia comando no chat
                pcall(function()
                    game:GetService("ReplicatedStorage").DefaultChatSystemChatEvents.SayMessageRequest:FireServer("/e dance", "All")
                end)
            end
        end)
    else
        btnAntiAFK.Text = "🛡 ANTI-AFK"
        btnAntiAFK.BackgroundColor3 = Color3.fromRGB(0, 150, 200)
    end
end

-- ========== FUNÇÃO 1: FARMAR OVOS ==========
local function iniciarFarmOvos()
    farmandoOvos = not farmandoOvos
    if farmandoOvos then
        btnOvos.Text = "⏹ PARAR OVOS"
        btnOvos.BackgroundColor3 = Color3.fromRGB(200, 0, 0)
        spawn(function()
            while farmandoOvos do
                task.wait(0.3)
                -- Coleta ovos do chão
                for _, objeto in pairs(workspace:GetChildren()) do
                    if objeto:IsA("Tool") and (objeto.Name:match("Ovo") or objeto.Name:match("Egg")) then
                        local posOvo = objeto:GetPivot()
                        if posOvo then
                            raiz.CFrame = posOvo * CFrame.new(0, 0, 2)
                            task.wait(0.1)
                            rato.Button1Click()
                            task.wait(0.15)
                        end
                    end
                end
                rato.Button1Click()
            end
        end)
    else
        btnOvos.Text = "🥚 FARMAR OVOS"
        btnOvos.BackgroundColor3 = Color3.fromRGB(0, 150, 50)
    end
end

-- ========== FUNÇÃO 2: FARMAR PIT ==========
local function iniciarFarmPIT()
    farmandoPIT = not farmandoPIT
    if farmandoPIT then
        btnPIT.Text = "⏹ PARAR PIT"
        btnPIT.BackgroundColor3 = Color3.fromRGB(200, 0, 0)
        spawn(function()
            while farmandoPIT do
                task.wait(0.5)
                -- Procura botão de luta
                local botaoLuta = nil
                for _, elemento in pairs(jogador.PlayerGui:GetDescendants()) do
                    if elemento:IsA("TextButton") and elemento.Visible then
                        local texto = elemento.Text or ""
                        if texto:match("LUTAR") or texto:match("FIGHT") or texto:match("BATALHAR") then
                            botaoLuta = elemento
                            break
                        end
                    end
                end
                if botaoLuta then
                    botaoLuta:Click()
                    task.wait(6)
                else
                    rato.Button1Click()
                    task.wait(1)
                end
            end
        end)
    else
        btnPIT.Text = "⚔️ FARMAR PIT"
        btnPIT.BackgroundColor3 = Color3.fromRGB(0, 150, 50)
    end
end

-- ========== FUNÇÃO 3: FARMAR SUCATA ==========
local function iniciarFarmSucata()
    farmandoSucata = not farmandoSucata
    if farmandoSucata then
        btnSucata.Text = "⏹ PARAR SUCATA"
        btnSucata.BackgroundColor3 = Color3.fromRGB(200, 0, 0)
        spawn(function()
            local posReciclador = nil
            for _, objeto in pairs(workspace:GetChildren()) do
                if objeto:IsA("Model") and (objeto.Name:match("Reciclador") or objeto.Name:match("Recycler")) then
                    if objeto:FindFirstChild("Head") then
                        posReciclador = objeto.Head.Position
                        break
                    end
                end
            end
            
            while farmandoSucata do
                task.wait(0.3)
                local coletou = false
                
                for _, objeto in pairs(workspace:GetChildren()) do
                    if objeto:IsA("Tool") and (objeto.Name:match("Sucata") or objeto.Name:match("Scrap") or objeto.Name:match("Metal")) then
                        local posSucata = objeto:GetPivot()
                        if posSucata then
                            raiz.CFrame = posSucata * CFrame.new(0, 0, 2)
                            task.wait(0.1)
                            rato.Button1Click()
                            coletou = true
                            task.wait(0.2)
                        end
                    end
                end
                
                if coletou and posReciclador then
                    raiz.CFrame = CFrame.new(posReciclador.X, posReciclador.Y, posReciclador.Z + 3)
                    task.wait(0.5)
                    for _, objeto in pairs(workspace:GetChildren()) do
                        if objeto:IsA("Tool") and (objeto.Name:match("Sucata") or objeto.Name:match("Scrap")) then
                            local posSucata = objeto:GetPivot()
                            if posSucata then
                                raiz.CFrame = posSucata * CFrame.new(0, 0, 2)
                                task.wait(0.1)
                                rato.Button1Click()
                                task.wait(0.2)
                            end
                        end
                    end
                end
            end
        end)
    else
        btnSucata.Text = "🔩 FARMAR SUCATA"
        btnSucata.BackgroundColor3 = Color3.fromRGB(0, 150, 50)
    end
end

-- ========== FUNÇÃO 4: COLETA AUTOMÁTICA ==========
