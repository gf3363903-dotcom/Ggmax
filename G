-- ========== FUNÇÃO CRIAR BOTÃO ==========
local function criarBotao(texto, posY, cor, callback)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0.85, 0, 0, 38)
    btn.Position = UDim2.new(0.075, 0, 0, posY)
    btn.Text = texto
    btn.BackgroundColor3 = cor
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.TextScaled = true
    btn.Font = Enum.Font.SourceSansBold
    
    local btnCorner = Instance.new("UICorner")
    btnCorner.CornerRadius = UDim.new(0, 5)
    btnCorner.Parent = btn
    
    btn.Parent = frame
    btn.MouseButton1Click:Connect(callback)
    return btn
end

-- ========== FUNÇÃO ANTI-AFK ==========
local function toggleAntiAFK()
    antiAFK = not antiAFK
    if antiAFK then
        btnAntiAFK.Text = "⏹ ANTI-AFK ATIVO"
        btnAntiAFK.BackgroundColor3 = Color3.fromRGB(200, 50, 0)
        spawn(function()
            while antiAFK do
                task.wait(30)
                local pos = raiz.Position
                raiz.CFrame = CFrame.new(pos.X + 0.5, pos.Y, pos.Z + 0.5)
                task.wait(0.1)
                raiz.CFrame = CFrame.new(pos.X, pos.Y, pos.Z)
                
                pcall(function()
                    game:GetService("ReplicatedStorage").DefaultChatSystemChatEvents.SayMessageRequest:FireServer("/e dance", "All")
                end)
            end
        end)
    else
        btnAntiAFK.Text = "🛡 ANTI-AFK"
        btnAntiAFK.BackgroundColor3 = Color3.fromRGB(0, 150, 200)
    end
end

-- ========== FARM OVOS ==========
local function toggleOvos()
    farmOvos = not farmOvos
    if farmOvos then
        btnOvos.Text = "⏹ PARAR OVOS"
        btnOvos.BackgroundColor3 = Color3.fromRGB(200, 0, 0)
        spawn(function()
            while farmOvos do
                task.wait(0.2)
                for _, obj in pairs(workspace:GetChildren()) do
                    if obj:IsA("Tool") and (string.find(obj.Name, "Ovo") or string.find(obj.Name, "Egg")) then
                        local pos = obj:GetPivot()
                        if pos then
                            raiz.CFrame = pos * CFrame.new(0, 0, 2)
                            task.wait(0.05)
                            game:GetService("VirtualInputManager"):SendMouseButtonEvent(0, 0, 0, true, game:GetService("UserInputService").MouseIcon, 0)
                            task.wait(0.05)
                            game:GetService("VirtualInputManager"):SendMouseButtonEvent(0, 0, 0, false, game:GetService("UserInputService").MouseIcon, 0)
                            task.wait(0.1)
                        end
                    end
                end
            end
        end)
    else
        btnOvos.Text = "🥚 FARMAR OVOS"
        btnOvos.BackgroundColor3 = Color3.fromRGB(0, 150, 50)
    end
end

-- ========== FARM PIT ==========
local function togglePIT()
    farmPIT = not farmPIT
    if farmPIT then
        btnPIT.Text = "⏹ PARAR PIT"
        btnPIT.BackgroundColor3 = Color3.fromRGB(200, 0, 0)
        spawn(function()
            while farmPIT do
                task.wait(0.5)
                local fightBtn = nil
                for _, obj in pairs(jogador.PlayerGui:GetDescendants()) do
                    if obj:IsA("TextButton") and obj.Visible then
                        local txt = obj.Text or ""
                        if string.find(txt, "LUTAR") or string.find(txt, "FIGHT") or string.find(txt, "BATALHAR") then
                            fightBtn = obj
                            break
                        end
                    end
                end
                if fightBtn then
                    fightBtn:Click()
                    task.wait(5)
                end
            end
        end)
    else
        btnPIT.Text = "⚔️ FARMAR PIT"
        btnPIT.BackgroundColor3 = Color3.fromRGB(0, 150, 50)
    end
end

-- ========== FARM SUCATA ==========
local function toggleSucata()
    farmSucata = not farmSucata
    if farmSucata then
        btnSucata.Text = "⏹ PARAR SUCATA"
        btnSucata.BackgroundColor3 = Color3.fromRGB(200, 0, 0)
        spawn(function()
            local reciclador = nil
            for _, obj in pairs(workspace:GetChildren()) do
                if obj:IsA("Model") and (string.find(obj.Name, "Reciclador") or string.find(obj.Name, "Recycler")) then
                    if obj:FindFirstChild("Head") then
                        reciclador = obj.Head.Position
                        break
                    end
                end
            end
            
            while farmSucata do
                task.wait(0.3)
                local coletou = false
                
                for _, obj in pairs(workspace:GetChildren()) do
                    if obj:IsA("Tool") and (string.find(obj.Name, "Sucata") or string.find(obj.Name, "Scrap") or string.find(obj.Name, "Metal")) then
                        local pos = obj:GetPivot()
                        if pos then
                            raiz.CFrame = pos * CFrame.new(0, 0, 2)
                            task.wait(0.05)
                            game:GetService("VirtualInputManager"):SendMouseButtonEvent(0, 0, 0, true, game:GetService("UserInputService").MouseIcon, 0)
                            task.wait(0.05)
                            game:GetService("VirtualInputManager"):SendMouseButtonEvent(0, 0, 0, false, game:GetService("UserInputService").MouseIcon, 0)
                            coletou = true
                            task.wait(0.2)
                        end
                    end
                end
                
                if coletou and reciclador then
                    raiz.CFrame = CFrame.new(reciclador.X, reciclador.Y, reciclador.Z + 3)
                    task.wait(0.5)
                    for _, obj in pairs(workspace:GetChildren()) do
                        if obj:IsA("Tool") and (string.find(obj.Name, "Sucata") or string.find(obj.Name, "Scrap")) then
                            local pos = obj:GetPivot()
                            if pos then
                                raiz.CFrame = pos * CFrame.new(0, 0, 2)
                                task.wait(0.05)
                                game:GetService("VirtualInputManager"):SendMouseButtonEvent(0, 0, 0, true, game:GetService("UserInputService").MouseIcon, 0)
                                task.wait(0.05)
                                game:GetService("VirtualInputManager"):SendMouseButtonEvent(0, 0, 0, false, game:GetService("UserInputService").MouseIcon, 0)
                                task.wait(0.2)
                            end
                        end
                    end
                end
            end
        end)
    else
        btnSucata.Text = "🔩 FARMAR SUCATA"
        btnSucata.BackgroundColor3 = Color3.fromRGB(0, 150, 50)
    end
end

