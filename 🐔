--[[
    Script All-in-One para Grow a Chicken Fighter - VERSÃO PT-BR
    Funcionalidades: Auto Farm Ovos, Auto PIT, Auto Sucata, Auto Coleta, Anti-AFK
    Como usar: Cole no executor (Delta, Hydrogen, etc.) e execute.
]]

local jogador = game.Players.LocalPlayer
local personagem = jogador.Character or jogador.CharacterAdded:Wait()
local raiz = personagem:WaitForChild("HumanoidRootPart")
local rato = jogador:GetMouse()

-- ========== VARIÁVEIS DE CONTROLE ==========
local farmandoOvos = false
local farmandoPIT = false
local farmandoSucata = false
local coletandoItens = false
local antiAFKAtivo = false

-- ========== CRIANDO A INTERFACE (GUI) ==========
local telaGUI = Instance.new("ScreenGui")
telaGUI.Parent = jogador.PlayerGui

local janela = Instance.new("Frame")
janela.Size = UDim2.new(0, 350, 0, 320)
janela.Position = UDim2.new(0.5, -175, 0.5, -160)
janela.BackgroundColor3 = Color3.fromRGB(20, 20, 40)
janela.BackgroundTransparency = 0.1
janela.Active = true
janela.Draggable = true
janela.Parent = telaGUI

-- Borda arredondada
local borda = Instance.new("UICorner")
borda.CornerRadius = UDim.new(0, 10)
borda.Parent = janela

local titulo = Instance.new("TextLabel")
titulo.Size = UDim2.new(1, 0, 0, 35)
titulo.Text = "🐔 AUTO FARM - GROW A CHICKEN"
titulo.TextColor3 = Color3.fromRGB(255, 215, 0)
titulo.BackgroundTransparency = 1
titulo.TextScaled = true
titulo.Parent = janela

-- ========== FUNÇÃO PARA CRIAR BOTÕES ==========
local function criarBotao(texto, posY, cor, funcao)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0.85, 0, 0, 35)
    btn.Position = UDim2.new(0.075, 0, 0, posY)
    btn.Text = texto
    btn.BackgroundColor3 = cor
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.TextScaled = true
    
    local btnBorda = Instance.new("UICorner")
    btnBorda.CornerRadius = UDim.new(0, 5)
    btnBorda.Parent = btn
    
    btn.Parent = janela
    btn.MouseButton1Click:Connect(funcao)
    return btn
end

-- ========== VARIÁVEIS DOS BOTÕES ==========
local btnOvos, btnPIT, btnSucata, btnColeta, btnAntiAFK

-- ========== FUNÇÃO ANTI-AFK ==========
local function iniciarAntiAFK()
    antiAFKAtivo = not antiAFKAtivo
    if antiAFKAtivo then
        btnAntiAFK.Text = "⏹ ANTI-AFK ATIVO"
        btnAntiAFK.BackgroundColor3 = Color3.fromRGB(200, 50, 0)
        spawn(function()
            while antiAFKAtivo do
                task.wait(60) -- A cada 1 minuto
                -- Simula um pequeno movimento para não ser desconectado
                local pos = raiz.Position
                raiz.CFrame = CFrame.new(pos.X + 0.1, pos.Y, pos.Z + 0.1)
                task.wait(0.1)
                raiz.CFrame = CFrame.new(pos.X, pos.Y, pos.Z)
                -- Digita algo no chat para manter ativo
                game:GetService("ReplicatedStorage").DefaultChatSystemChatEvents.SayMessageRequest:FireServer("/e dance", "All")
            end
        end)
    else
        btnAntiAFK.Text = "▶️ ANTI-AFK"
        btnAntiAFK.BackgroundColor3 = Color3.fromRGB(0, 150, 200)
    end
end

-- ========== FUNÇÃO 1: FARMAR OVOS ==========
local function iniciarFarmOvos()
    farmandoOvos = not farmandoOvos
    if farmandoOvos then
        btnOvos.Text = "⏹ PARAR OVOS"
        btnOvos.BackgroundColor3 = Color3.fromRGB(200, 0, 0)
        spawn(function()
            while farmandoOvos do
                task.wait(0.3)
                -- Procura por ovos no chão
                for _, objeto in pairs(workspace:GetChildren()) do
                    if objeto:IsA("Tool") and (objeto.Name:match("Ovo") or objeto.Name:match("Egg")) then
                        local posOvo = objeto:GetPivot()
                        if posOvo then
                            raiz.CFrame = posOvo * CFrame.new(0, 0, 2)
                            task.wait(0.1)
                            rato.Button1Click()
                            task.wait(0.2)
                        end
                    end
                end
                -- Click automático para acelerar postura
                rato.Button1Click()
            end
        end)
    else
        btnOvos.Text = "▶️ FARMAR OVOS"
        btnOvos.BackgroundColor3 = Color3.fromRGB(0, 150, 50)
    end
end

-- ========== FUNÇÃO 2: FARMAR PIT (LUTAS) ==========
local function iniciarFarmPIT()
    farmandoPIT = not farmandoPIT
    if farmandoPIT then
        btnPIT.Text = "⏹ PARAR PIT"
        btnPIT.BackgroundColor3 = Color3.fromRGB(200, 0, 0)
        spawn(function()
            while farmandoPIT do
                task.wait(0.5)
                -- Procura pelo botão de luta
                local botaoLuta = nil
                for _, elemento in pairs(jogador.PlayerGui:GetDescendants()) do
                    if elemento:IsA("TextButton") and elemento.Visible then
                        local texto = elemento.Text or ""
                        if texto:match("LUTAR") or texto:match("FIGHT") or texto:match("BATALHAR") then
                            botaoLuta = elemento
                            break
                        end
                    end
                end
                if botaoLuta then
                    botaoLuta:Click()
                    task.wait(6) -- Tempo para a luta terminar
                else
                    -- Tenta clicar no centro da tela se não achar o botão
                    rato.Button1Click()
                    task.wait(1)
                end
            end
        end)
    else
        btnPIT.Text = "▶️ FARMAR PIT"
        btnPIT.BackgroundColor3 = Color3.fromRGB(0, 150, 50)
    end
end

-- ========== FUNÇÃO 3: FARMAR SUCATA ==========
local function iniciarFarmSucata()
    farmandoSucata = not farmandoSucata
    if farmandoSucata then
        btnSucata.Text = "⏹ PARAR SUCATA"
        btnSucata.BackgroundColor3 = Color3.fromRGB(200, 0, 0)
        spawn(function()
            -- Encontra a posição do reciclador
            local posReciclador = nil
            for _, objeto in pairs(workspace:GetChildren()) do
                if objeto:IsA("Model") and (objeto.Name:match("Reciclador") or objeto.Name:match("Recycler")) then
                    if objeto:FindFirstChild("Head") then
                        posReciclador = objeto.Head.Position
                        break
                    end
                end
            end
            
            while farmandoSucata do
                task.wait(0.3)
                local coletou = false
                
                -- Coleta sucata na arena
                for _, objeto in pairs(workspace:GetChildren()) do
                    if objeto:IsA("Tool") and (objeto.Name:match("Sucata") or objeto.Name:match("Scrap") or objeto.Name:match("Metal")) then
                        local posSucata = objeto:GetPivot()
                        if posSucata then
                            raiz.CFrame = posSucata * CFrame.new(0, 0, 2)
                            task.wait(0.1)
                            rato.Button1Click()
                            coletou = true
                            task.wait(0.2)
                        end
                    end
                end
                
                -- Se coletou algo, volta para o reciclador
                if coletou and posReciclador then
                    raiz.CFrame = CFrame.new(posReciclador.X, posReciclador.Y, posReciclador.Z + 3)
                    task.wait(0.5)
                    -- Deposita a sucata
                    for _, objeto in pairs(workspace:GetChildren()) do
                        if objeto:IsA("Tool") and (objeto.Name:match("Sucata") or objeto.Name:match("Scrap")) then
                            local posSucata = objeto:GetPivot()
                            if posSucata then
                                raiz.CFrame = posSucata * CFrame.new(0, 0, 2)
                                task.wait(0.1)
                                rato.Button1Click()
                                task.wait(0.2)
                            end
                        end
                    end
                end
            end
        end)
    else
        btnSucata.Text = "▶️ FARMAR SUCATA"
        btnSucata.BackgroundColor3 = Color3.fromRGB(0, 150, 50)
    end
end

-- ========== FUNÇÃO 4: COLETA AUTOMÁTICA DE ITENS ==========
local function iniciarColetaItens()
    coletandoItens = not coletandoItens
    if coletandoItens then
        btnColeta.Text = "⏹ PARAR COLETA"
        btnColeta.BackgroundColor3 = Color3.fromRGB(200, 0, 0)
        spawn(function()
            while coletandoItens do
                task.wait(0.3)
                -- Coleta TUDO que está no chão
                for _, objeto in pairs(workspace:GetChildren()) do
                    if objeto:IsA("Tool") then
                        local posItem = objeto:GetPivot()
                        if posItem then
                            raiz.CFrame = posItem * CFrame.new(0, 0, 2)
                            task.wait(0.1)
                            rato.Button1Click()
                            task.wait(0.15)
                        end
                    end
                end
            end
        end)
    else
        btnColeta.Text = "▶️ COLETAR TUDO"
        btnColeta.BackgroundColor3 = Color3.fromRGB(200, 150, 0)
    end
end

-- ========== FUNÇÃO 5: AUTO CLICK RÁPIDO ==========
local function iniciarAutoClick()
    -- Função extra: segure F para ativar/desativar click rápido
    local autoClickAtivo = false
    game:GetService("UserInputService").InputBegan:Connect(function(input)
        if input.KeyCode == Enum.KeyCode.F then
            autoClickAtivo = not autoClickAtivo
            if autoClickAtivo then
                print("🔄 Auto-Click ATIVADO (segure F para desativar)")
                spawn(function()
                    while autoClickAtivo do
                        task.wait(0.05)
                        rato.Button1Click()
                    end
                end)
            else
                print("🔄 Auto-Click DESATIVADO")
            end
        end
    end)
end

-- ========== CRIANDO OS BOTÕES DA GUI ==========
btnOvos = criarBotao("▶️ FARMAR OVOS", 45, Color3.fromRGB(0, 150, 50), iniciarFarmOvos)
btnPIT = criarBotao("▶️ FARMAR PIT", 85, Color3.fromRGB(0, 150, 50), iniciarFarmPIT)
btnSucata = criarBotao("▶️ FARMAR SUCATA", 125, Color3.fromRGB(0, 150, 50), iniciarFarmSucata)
btnColeta = criarBotao("▶️ COLETAR TUDO", 165, Color3.fromRGB(200, 150, 0), iniciarColetaItens)
btnAntiAFK = criarBotao("▶️ ANTI-AFK", 205, Color3.fromRGB(0, 150, 200), iniciarAntiAFK)

