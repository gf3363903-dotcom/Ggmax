    print("🔩 Farmar Sucata: Coleta e recicla sucata")
    print("📦 Coletar Tudo: Pega qualquer item no chão")
    print("🛡️ Anti-AFK: Evita ser desconectado")
    print("🔄 Auto-Click: Pressione F para ativar/desativar")
end)

-- ========== INICIALIZAR AUTO-CLICK ==========
iniciarAutoClick()

