local Pages = {}
local TabButtons = {}

local function createPage(name)
	local page = Instance.new("Frame")
	page.Name = name
	page.Size = UDim2.new(1, 0, 1, 0)
	page.BackgroundTransparency = 1
	page.Visible = false
	page.Parent = Content

	Pages[name] = page

	return page
end

local FarmPage = createPage("Farm")
local TowerPage = createPage("Torre")
local EventPage = createPage("Eventos")

--==================================================
-- BOTÕES
--==================================================

local function createActionButton(parent, text, y, callback)
	local button = Instance.new("TextButton")

	button.Size = UDim2.new(1, -30, 0, 45)
	button.Position = UDim2.fromOffset(15, y)
	button.BackgroundColor3 = Color3.fromRGB(50, 50, 62)
	button.BorderSizePixel = 0
	button.Text = text
	button.TextColor3 = Color3.new(1, 1, 1)
	button.TextSize = 15
	button.Font = Enum.Font.GothamSemibold
	button.Parent = parent

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 8)
	corner.Parent = button

	button.MouseButton1Click:Connect(function()
		callback(button)
	end)

	return button
end

local function createTab(name)
	local button = Instance.new("TextButton")

	button.Size = UDim2.fromOffset(120, 38)
	button.BackgroundColor3 = Color3.fromRGB(45, 45, 55)
	button.BorderSizePixel = 0
	button.Text = name
	button.TextColor3 = Color3.new(1, 1, 1)
	button.TextSize = 14
	button.Font = Enum.Font.GothamBold
	button.Parent = Tabs

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 8)
	corner.Parent = button

	TabButtons[name] = button

	return button
end

local function showPage(name)
	for pageName, page in pairs(Pages) do
		page.Visible = pageName == name
	end

	for tabName, button in pairs(TabButtons) do
		if tabName == name then
			button.BackgroundColor3 = Color3.fromRGB(85, 120, 210)
		else
			button.BackgroundColor3 = Color3.fromRGB(45, 45, 55)
		end
	end
end

local FarmTab = createTab("⚔️ Farm")
local TowerTab = createTab("🗼 Torre")
local EventTab = createTab("🎉 Eventos")

FarmTab.MouseButton1Click:Connect(function()
	showPage("Farm")
end)

TowerTab.MouseButton1Click:Connect(function()
	showPage("Torre")
end)

EventTab.MouseButton1Click:Connect(function()
	showPage("Eventos")
end)

