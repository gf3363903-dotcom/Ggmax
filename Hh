-- =========================
-- CRIAR BOTÃO
-- =========================

local function criarBotao(texto, posY, cor, callback)

    local btn = Instance.new("TextButton")

    btn.Size = UDim2.new(0.85, 0, 0, 38)
    btn.Position = UDim2.new(0.075, 0, 0, posY)

    btn.Text = texto
    btn.BackgroundColor3 = cor
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)

    btn.TextScaled = true
    btn.Font = Enum.Font.SourceSansBold

    local btnCorner = Instance.new("UICorner")
    btnCorner.CornerRadius = UDim.new(0, 5)
    btnCorner.Parent = btn

    btn.Parent = frame

    btn.MouseButton1Click:Connect(function()
        local sucesso, erro = pcall(callback)

        if not sucesso then
            warn("Erro no botão:", erro)
        end
    end)

    return btn
end

-- =========================
-- FUNÇÃO DE CLIQUE
-- =========================

local function clicar()

    local virtualInput

    local sucesso = pcall(function()
        virtualInput = game:GetService("VirtualInputManager")
    end)

    if not sucesso or not virtualInput then
        return false
    end

    local ok = pcall(function()

        virtualInput:SendMouseButtonEvent(
            0,
            0,
            0,
            true,
            game:GetService("UserInputService").MouseIcon,
            0
        )

        task.wait(0.05)

        virtualInput:SendMouseButtonEvent(
            0,
            0,
            0,
            false,
            game:GetService("UserInputService").MouseIcon,
            0
        )

    end)

    return ok
end

-- =========================
-- ANTI-AFK
-- =========================

local function toggleAntiAFK()

    antiAFK = not antiAFK

    if antiAFK then

        btnAntiAFK.Text = "⏹ ANTI-AFK ATIVO"
        btnAntiAFK.BackgroundColor3 = Color3.fromRGB(200, 50, 0)

        task.spawn(function()

            while antiAFK do

                task.wait(30)

                if not antiAFK then
                    break
                end

                if raiz and raiz.Parent then

                    local pos = raiz.Position

                    pcall(function()
                        raiz.CFrame = CFrame.new(
                            pos.X + 0.5,
                            pos.Y,
                            pos.Z + 0.5
                        )

                        task.wait(0.1)

                        raiz.CFrame = CFrame.new(
                            pos.X,
                            pos.Y,
                            pos.Z
                        )
                    end)

                end

                pcall(function()

                    local chatEvents =
                        ReplicatedStorage:FindFirstChild(
                            "DefaultChatSystemChatEvents"
                        )

                    local sayMessage =
                        chatEvents and
                        chatEvents:FindFirstChild(
                            "SayMessageRequest"
                        )

                    if sayMessage then
                        sayMessage:FireServer(
                            "/e dance",
                            "All"
                        )
                    end

                end)

            end

        end)

    else

        btnAntiAFK.Text = "🛡 ANTI-AFK"
        btnAntiAFK.BackgroundColor3 =
            Color3.fromRGB(0, 150, 200)

    end
end

-- =========================
-- FARM OVOS
-- =========================

local function toggleOvos()

    farmOvos = not farmOvos

    if farmOvos then

        btnOvos.Text = "⏹ PARAR OVOS"
        btnOvos.BackgroundColor3 =
            Color3.fromRGB(200, 0, 0)

        task.spawn(function()

            while farmOvos do

                task.wait(0.2)

                if not raiz or not raiz.Parent then
                    task.wait(1)
                    continue
                end

                for _, obj in ipairs(workspace:GetDescendants()) do

                    if not farmOvos then
                        break
                    end

                    if obj:IsA("Tool") then

                        local nome = string.lower(obj.Name)

                        if string.find(nome, "ovo")
                        or string.find(nome, "egg") then

                            local sucesso, pos = pcall(function()
                                return obj:GetPivot()
                            end)

                            if sucesso and pos then

                                pcall(function()

                                    raiz.CFrame =
                                        pos * CFrame.new(0, 0, 2)

                                    task.wait(0.05)

                                    clicar()

                                end)

                                task.wait(0.1)

                            end
                        end
                    end
                end
            end

        end)

    else

        btnOvos.Text = "🥚 FARMAR OVOS"
        btnOvos.BackgroundColor3 =
            Color3.fromRGB(0, 150, 50)

    end
end

-- =========================
-- FARM PIT
-- =========================

local function togglePIT()

    farmPIT = not farmPIT

    if farmPIT then

        btnPIT.Text = "⏹ PARAR PIT"
        btnPIT.BackgroundColor3 =
            Color3.fromRGB(200, 0, 0)

        task.spawn(function()

            while farmPIT do

                task.wait(0.5)

                local fightBtn = nil

                for _, obj in ipairs(
                    jogador.PlayerGui:GetDescendants()
                ) do

                    if obj:IsA("TextButton")
                    and obj.Visible then

                        local txt =
                            string.lower(obj.Text or "")

                        if string.find(txt, "lutar")
                        or string.find(txt, "fight")
                        or string.find(txt, "batalhar") then

                            fightBtn = obj
                            break

                        end
                    end
                end

                if fightBtn then

                    pcall(function()
                        fightBtn:Activate()
                    end)

                    task.wait(5)

                end

            end

        end)

    else

        btnPIT.Text = "⚔️ FARMAR PIT"
        btnPIT.BackgroundColor3 =
            Color3.fromRGB(0, 150, 50)

    end
end

-- =========================
-- FARM SUCATA
-- =========================

local function toggleSucata()

    farmSucata = not farmSucata

    if farmSucata then

        btnSucata.Text = "⏹ PARAR SUCATA"
        btnSucata.BackgroundColor3 =
            Color3.fromRGB(200, 0, 0)

        task.spawn(function()

            local reciclador = nil

            for _, obj in ipairs(
                workspace:GetDescendants()
            ) do

                if obj:IsA("Model") then

                    local nome =
                        string.lower(obj.Name)

                    if string.find(nome, "reciclador")
                    or string.find(nome, "recycler") then

                        local head =
                            obj:FindFirstChild("Head")

                        if head and head:IsA("BasePart") then

                            reciclador = head.Position
                            break

                        end
                    end
                end
            end

            while farmSucata do

                task.wait(0.3)

                if not raiz or not raiz.Parent then
                    task.wait(1)
                    continue
                end

                local coletou = false

                for _, obj in ipairs(
                    workspace:GetDescendants()
                ) do

                    if not farmSucata then
                        break
                    end

                    if obj:IsA("Tool") then

                        local nome =
                            string.lower(obj.Name)

                        if string.find(nome, "sucata")
                        or string.find(nome, "scrap")
                        or string.find(nome, "metal") then

                            local sucesso, pos =
                                pcall(function()
                                    return obj:GetPivot()
                                end)

                            if sucesso and pos then

                                pcall(function()

                                    raiz.CFrame =
                                        pos * CFrame.new(0, 0, 2)

                                    task.wait(0.05)

                                    clicar()

                                end)

                                coletou = true

                                task.wait(0.2)

                            end
                        end
                    end
                end

                if coletou and reciclador then

                    pcall(function()

                        raiz.CFrame =
                            CFrame.new(
                                reciclador.X,
                                reciclador.Y,
                                reciclador.Z + 3
                            )

                    end)

                    task.wait(0.5)

                end

            end

        end)

    else

        btnSucata.Text = "🔩 FARMAR SUCATA"
        btnSucata.BackgroundColor3 =
            Color3.fromRGB(0, 150, 50)

    end
end

